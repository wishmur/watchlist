# Copy to .env and fill in. .env is gitignored and is loaded automatically by
# scripts/local_env.py, so you do not need to `source` it before running.
# Real environment variables always take precedence, which is how GitHub
# Actions supplies these from repo secrets.

# Secret. Bypasses RLS. Never commit this or put it in the frontend.
SUPABASE_SERVICE_KEY=
SUPABASE_URL=

# Secret.
ANTHROPIC_API_KEY=

# Optional, and NOT a secret: the publishable/anon key, which is gated by RLS
# and is already embedded in the frontend bundle by design. Set it so
# check_schema.py can verify the public read surface from the outside --
# that anon can read the board views, and cannot read companies/jobs/matches.
# Without it those checks are skipped, which is how sql/005 went unnoticed.
SUPABASE_ANON_KEY=
